# YouTube API Configuration
# Note: Efficient API now pulls latest uploads per subscribed channel and pages within the age window to preserve balanced coverage.
YT_MAX_VIDEOS=30
YT_MAX_AGE_DAYS=14
YT_PER_CHANNEL_LIMIT=3
YT_EXCLUDE_SHORTS=1
YT_SHORTS_MAX_SECONDS=180
YT_STATE_FILE=yt_state.json

# API Efficiency (default: enabled, STRONGLY recommended)
# Efficient API: ~21 calls/run, searches 20 channels with 15 videos each
# Legacy API: 200+ calls/run, may hit rate limits and cause quota exhaustion
YT_USE_EFFICIENT_API=1

# Output directory for markdown files
OUTPUT_DIR=./ToJoplin

# Transcript preferences
YT_TRANSCR_PREF_LANGS=en,en-US,en-GB,en-CA,en-AU
YT_TRANSLATE_TO=en
YT_ACCEPT_NON_EN=1
YT_MARK_PROCESSED_ON_NO_TRANSCRIPT=0

# Optional: OpenAI API for better summaries
# OPENAI_API_KEY=your-openai-api-key-here
# Generic family names are supported for OpenAI-compatible endpoints; e.g. gemma-4 can resolve to an MLX/local variant.
OPENAI_MODEL=gemma-4

# Optional: YouTube Takeout watch history (JSON file)
# YT_TAKEOUT_WATCH_JSON=path/to/takeout/watch-history.json

# Optional: YouTube cookies for gated content (Netscape format)
# YT_COOKIES_FILE=~/youtube_cookies.txt

# Optional: Proxy settings (if needed for transcript access)
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=https://proxy:port

# Logging
YT_LOG_SKIPS=1
# Log level: ERROR (only errors), WARN (errors + warnings), INFO (all messages)
# INFO shows routine skips like "already processed", "SHORT", etc.
# WARN shows transcript errors and important warnings  
# ERROR shows only critical errors (default, reduces noise)
YT_LOG_LEVEL=ERROR
